# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
MAX_REQUEST_SIZE=10485760
REQUEST_TIMEOUT=30
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/xiaotian
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=1
DB_CONNECT_TIMEOUT=30
DB_IDLE_TIMEOUT=600

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=10
REDIS_CONNECT_TIMEOUT=5
REDIS_COMMAND_TIMEOUT=5
REDIS_DEFAULT_TTL=3600

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
EMAIL_SENDER=小天AI助手 <noreply@xiaotian.ai>
EMAIL_SUBJECT=每日技术资讯摘要 - {date}
EMAIL_HEADER_TEXT=以下是今日为您精选的技术资讯摘要：
EMAIL_FOOTER_TEXT=感谢使用小天AI助手
EMAIL_INCLUDE_ORIGINAL_LINKS=true
EMAIL_GROUP_BY_FEED=true

# AI Configuration
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=your-openai-api-key
AI_MODEL=gpt-3.5-turbo
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.7
AI_TIMEOUT=60

# Sync Configuration
SYNC_MAX_ITEMS=50
SYNC_SUMMARY_LENGTH=medium
SYNC_INTERVAL_MINUTES=60
SYNC_REQUEST_TIMEOUT=30
SYNC_USER_AGENT=Xiaotian-RSS-Reader/1.0

# Application Configuration
APP_NAME=Xiaotian API
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
LOG_LEVEL=info
MAX_CHAT_SESSIONS_PER_USER=10
MAX_FEEDS_PER_USER=50
DATA_RETENTION_DAYS=365